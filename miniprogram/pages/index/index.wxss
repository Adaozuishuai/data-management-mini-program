page{background:#fcf8f1;color:#25254b;font-family:-apple-system,"PingFang SC",sans-serif;font-size:30rpx;line-height:1.5}
.shell{padding:24rpx 30rpx 72rpx}.editing{padding-bottom:190rpx}
.hero,.detailHead{position:relative;overflow:hidden;background:#10158e;color:#fff2d9;border-radius:32rpx;padding:36rpx}.heroInner{position:relative}.eyebrow{color:#e6e4ff;font-size:23rpx;font-weight:600;letter-spacing:2rpx}.heroTitle{font-size:62rpx;letter-spacing:-2rpx;font-weight:700;margin:12rpx 0 35rpx;line-height:1.18}.metrics{display:flex;border-top:1rpx solid #777bcd;padding-top:22rpx;gap:38rpx;font-size:24rpx;color:#e6e4ff;align-items:baseline}.number{font-size:40rpx;line-height:1;font-weight:600;color:#fff2d9}.contours{position:absolute;right:-158rpx;top:-108rpx;width:440rpx;height:420rpx;transform:rotate(-28deg)}.contours view{position:absolute;border:2rpx solid #777bcd;border-radius:43% 57% 62% 38%;inset:0}.contours view:nth-child(2){inset:18rpx}.contours view:nth-child(3){inset:36rpx}.contours view:nth-child(4){inset:54rpx}.contours view:nth-child(5){inset:72rpx}.contours view:nth-child(6){inset:90rpx}
.sectionHead,.back,.dateRow,.row,.search,.tabs,.actions{display:flex;align-items:center}.sectionHead,.back,.dateRow{justify-content:space-between}.sectionHead{margin:38rpx 0 20rpx}.heading{font-size:36rpx;font-weight:650}.title{font-size:45rpx;font-weight:700;line-height:1.32;margin:22rpx 0}.back,.hint,.demo,.empty{color:#514f66;font-size:25rpx}.back{padding:8rpx 0 24rpx}.back text:first-child,.link{color:#242788;font-weight:600}.demo{text-align:center;margin-top:28rpx}.hint{margin-top:4rpx}.empty{padding:30rpx}.grow{flex:1;min-width:0;overflow-wrap:anywhere}.arrow{color:#666594;font-size:38rpx;line-height:1}
button{color:white;background:#24289c;font-size:29rpx;font-weight:600;border-radius:18rpx;margin:20rpx 0 0;padding:0 22rpx;line-height:84rpx}button::after{border:0}.new{margin:0;border-radius:999rpx;line-height:68rpx;font-size:26rpx}.search{border:1rpx solid #d8d5e4;background:#fff;border-radius:18rpx;padding:0 24rpx;gap:20rpx;margin-bottom:20rpx}.lens{width:21rpx;height:21rpx;border:3rpx solid #666594;border-radius:50%;position:relative}.lens::after{content:"";display:block;position:absolute;width:11rpx;height:3rpx;background:#666594;right:-8rpx;bottom:-4rpx;transform:rotate(45deg)}.search input{background:transparent;border:0;margin:0;padding-left:0;flex:1}
.list,.group,.source{background:#fff;border:1rpx solid #d8d5e4;border-radius:22rpx;overflow:hidden}.row{min-height:92rpx;padding:12rpx 24rpx;gap:16rpx;box-sizing:border-box;border-bottom:1rpx solid #e8e5ee}.row:last-child{border:0}.patientRow{padding:24rpx}.patientId{font-size:37rpx;font-weight:650;letter-spacing:1rpx}.folder{background:#e0dcff;width:76rpx;height:80rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center}.folder view{width:29rpx;height:37rpx;border:3rpx solid #7970be;border-radius:5rpx;position:relative}.folder view::after{content:"";position:absolute;left:5rpx;right:5rpx;top:11rpx;height:7rpx;border-block:2rpx solid #7970be}
.tabs{margin:24rpx 0;background:#eae8ff;padding:6rpx;border-radius:17rpx}.tabs view{flex:1;text-align:center;padding:16rpx 0;font-size:27rpx}.tabs .active{background:#fff;border-radius:12rpx;font-weight:650;color:#242788}.dateRow{padding:22rpx;background:#eae8ff;border-radius:14rpx;font-size:27rpx}.pill{background:#eae8ff;color:#242788;padding:4rpx 14rpx;border-radius:20rpx;font-size:23rpx}.pending{background:#efedf1;color:#514f66}.group,.source{padding:24rpx;margin:18rpx 0}.label{font-weight:600;margin:16rpx 0 8rpx}.field,input,textarea{box-sizing:border-box;background:#f9f8fc;border:1rpx solid #d8d5e4;padding:16rpx 18rpx;border-radius:12rpx;width:100%;min-height:78rpx;margin:8rpx 0 20rpx;font-size:28rpx}.link{padding:20rpx 0;font-size:26rpx}.source{display:block;white-space:pre-wrap;line-height:1.75;font-size:26rpx}.notice{background:#fff0d8;padding:16rpx;border-radius:10rpx}.secondary{background:#eae8ff;color:#242788}.actions{position:fixed;bottom:0;left:0;right:0;gap:12rpx;padding:16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));background:white;border-top:1rpx solid #d8d5e4;z-index:2}.actions button{flex:1;margin:0;font-size:26rpx}

.question{padding:18rpx 0;border-bottom:1rpx solid #e8e5ee}
.question:last-child{border-bottom:0}
.question .label{margin:0 0 14rpx;line-height:1.5}
.choices{display:flex;flex-wrap:wrap;gap:12rpx}
.option{display:flex;align-items:center;gap:12rpx;min-height:72rpx;padding:0 20rpx;border:2rpx solid #d8d5e4;border-radius:14rpx;background:#fff;color:#393952;font-size:28rpx;box-sizing:border-box}
.selected{border-color:#24289c;background:#eae8ff;color:#242788;font-weight:600}
.radioDot{width:20rpx;height:20rpx;border:2rpx solid #666594;border-radius:50%;box-sizing:border-box}
.selected .radioDot{border:6rpx solid #24289c;background:white}
.legacy,.unitRead{font-size:25rpx;color:#514f66;margin:10rpx 0}

/* Orange bookmark echoes the study illustration. */
.hero::after,.detailHead::after{content:"";position:absolute;top:0;right:54rpx;width:26rpx;height:46rpx;background:#ff6126;clip-path:polygon(0 0,100% 0,100% 100%,50% 78%,0 100%);pointer-events:none}
